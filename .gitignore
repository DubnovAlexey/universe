# ==============================================================================
# ФАЙЛ: .gitignore
# НАЗНАЧЕНИЕ: Указывает системе контроля версий Git, какие файлы нужно ИГНОРИРОВАТЬ
# и НИКОГДА не отправлять в интернет (на GitHub).
# ==============================================================================

# 1. Зависимости Node.js (скачиваются локально, весят сотни мегабайт)
node_modules/

# 2. Локальные секреты и пароли (Критично для безопасности!)
.env

# 3. Артефакты сборки физического движка Rust (`target` папка)
physics_engine/target/

# 4. Артефакты сборки фронтенда Astro
frontend/dist/
frontend/.astro/
frontend/.next/
frontend/.nuxt/

# 5. Системные файлы IntelliJ IDEA и macOS/Windows
.idea/
*.iml
.DS_Store