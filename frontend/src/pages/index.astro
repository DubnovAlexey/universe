---
// noinspection SpellCheckingInspection
// ============================================================================
// ФАЙЛ: frontend/src/pages/index.astro
// НАЗНАЧЕНИЕ: Главная сцена v2.5 — заголовок ссылки "Alexey Dubnov"
// ============================================================================
import '../styles/universe.css';
import { UNIVERSE_PHASES, PHASE_ORDER } from '../store/universeState';

const initialPhase = UNIVERSE_PHASES['01_VOID'];
const rawBaseUrl = import.meta.env.BASE_URL || '/';
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<!doctype html>
<html lang="ru">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
	<title>Alexey Dubnov</title>
	<link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
	<meta property="og:image" content={`https://dubnovalexey.github.io${baseUrl}favicon.png`} />
</head>

<body>
<main class="universe-viewport">
	<canvas
		id="universe-canvas"
		aria-label="Интерактивное космическое и нейронное полотно UNIVERSE"
	></canvas>

	<div class="optical-vignette"></div>

	<button
		type="button"
		id="ui-audio-unlock-banner"
		class="audio-unlock-banner"
		aria-label="Включить космическое звуковое сопровождение"
	>
		[ 🔊 TAP / CLICK TO ENGAGE AUDIO ]
	</button>

	<div id="layer5-finale-root"></div>

	<div class="hud-overlay" id="hud-overlay-root">
		<header class="hud-top-bar">
			<section class="hud-panel brand-card" data-ui-panel="true">
				<span class="phase-codename" id="ui-phase-codename">{initialPhase.codeName}</span>
				<h1 class="phase-title" id="ui-phase-title">{initialPhase.titleRu}</h1>
				<p class="phase-subtitle" id="ui-phase-subtitle">{initialPhase.subtitleRu}</p>
				<p class="phase-philosophy" id="ui-phase-philosophy">{initialPhase.philosophyRu}</p>
			</section>

			<div class="inspection-islands-stack" aria-label="Каскад телеметрии Цифрового Водопада">
				<div id="layer2-metrics-root" class="waterfall-island-slot"></div>
				<div id="layer3-topology-root" class="waterfall-island-slot"></div>
				<div id="layer4-terminal-root" class="waterfall-island-slot"></div>
			</div>
		</header>

		<footer class="hud-bottom-bar">
			<nav
				class="hud-panel phase-timeline-dock"
				data-ui-panel="true"
				aria-label="Шкала 5 фаз эволюции Вселенной (108 секунд)"
			>
				<div class="timeline-progress-track">
					<div class="timeline-progress-fill" id="ui-phase-progress"></div>
				</div>
				<div class="phase-buttons-row" id="ui-phase-buttons">
					{
						PHASE_ORDER.map((phaseKey, idx) => (
							<button
								type="button"
								class={`phase-pill ${idx === 0 ? 'active' : ''}`}
								data-phase-id={phaseKey}
								title={UNIVERSE_PHASES[phaseKey].subtitleRu}
							>
								0{idx + 1}.{phaseKey.split('_')[1]}
							</button>
						))
					}
				</div>
			</nav>

			<section
				class="hud-panel controls-dock"
				data-ui-panel="true"
				aria-label="Управление звуком, инженерными оптиками и переходом в GitHub"
			>
				<button type="button" class="btn-cyber" id="btn-toggle-pause" title="Пауза / Продолжить (Клавиша P)">
					⏸ PAUSE
				</button>
				<button type="button" class="btn-cyber active-toggle" id="btn-toggle-autocycle" title="Автоматический 108-секундный цикл">
					🔄 AUTO: ON
				</button>
				<button type="button" class="btn-cyber" id="btn-toggle-audio" title="Включить / Выключить звук (Клавиша M)">
					🔊 AUDIO: WAIT
				</button>
				<button type="button" class="btn-cyber active-toggle" id="btn-toggle-metrics" title="Телеметрия полиглот-ядра (Клавиша 2)">
					📊 METRICS
				</button>
				<button type="button" class="btn-cyber active-toggle" id="btn-toggle-topology" title="Топология графа NEXUS (Клавиша 3)">
					🕸 TOPOLOGY
				</button>
				<button type="button" class="btn-cyber active-toggle" id="btn-toggle-terminal" title="Терминал и IntegrationRegistry (Клавиша 4)">
					⌨ TERMINAL
				</button>
				<button type="button" class="btn-cyber" id="btn-toggle-xray" title="Глобальный инженерный рентген X-RAY (Клавиша 5)">
					🔬 X-RAY
				</button>
				<a
					class="btn-cyber btn-github-profile"
					id="link-hud-github"
					href="https://github.com/DubnovAlexey"
					target="_blank"
					rel="noopener noreferrer"
					title="Перейти на главную страницу профиля GitHub — Dubnov Alexey"
				>
					↗ GITHUB
				</a>
			</section>
		</footer>
	</div>
</main>

<script src="../engine/renderer.ts"></script>
</body>
</html>