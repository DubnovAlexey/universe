---
// noinspection SpellCheckingInspection
// ============================================================================
// ФАЙЛ: frontend/src/pages/index.astro
// НАЗНАЧЕНИЕ: Главная сцена инсталляции UNIVERSE v2.3 (MASTER 00–99)
// АРХИТЕКТУРНЫЕ РАЗДЕЛЫ МОДУЛЯ (ДЛЯ ТЕХНИЧЕСКОГО ОБСЛУЖИВАНИЯ):
// 1. Инициализация стилей и метаданных: импорт глобальной системы стилей
//    universe.css, конфигурации 5 фаз (UNIVERSE_PHASES) и расчёт базового
//    пути BASE_URL для совместимости с GitHub Pages.
// 2. Полноэкранный графический слой (Layer 1): размещение холста #universe-canvas
//    и оптической виньетки .optical-vignette для рендеринга оптик ILLUSION,
//    NEXUS, BREACH X-RAY и финального квантового одометра.
// 3. Финальный семантический слой (Layer 5): точка монтирования #layer5-finale-root
//    для интерактивной визитки GitHub, блока aria-live и перезапуска цикла.
// 4. Парящий интерфейс телеметрии и управления (HUD Overlay): паспорт текущей
//    фазы (.brand-card), полноразмерная правая колонка телеметрии Водопада
//    (#layer2-metrics-root, #layer3-topology-root, #layer4-terminal-root)
//    и нижний док переключения 5 фаз и инженерных режимов.
// ============================================================================
import '../styles/universe.css';
import { UNIVERSE_PHASES, PHASE_ORDER } from '../store/universeState';

const initialPhase = UNIVERSE_PHASES['01_VOID'];
const rawBaseUrl = import.meta.env.BASE_URL || '/';
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<!doctype html>
<html lang="ru">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>UNIVERSE // NEUROVERSE — Interactive Polyglot Audiovisual Installation</title>
	<meta
		name="description"
		content="Полноэкранная кинематографическая аудиовизуальная инсталляция «Из Нуля в Ноль» (108 секунд): Astro, TypeScript, React, WebGPU, Rust/WASM, Python."
	/>
	<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
</head>

<body>
<main class="universe-viewport">
	<!-- ЭТАП 1: Полноэкранный холст единой симуляции (ILLUSION + NEXUS + BREACH X-RAY + ODOMETER) -->
	<canvas
		id="universe-canvas"
		aria-label="Интерактивное космическое и нейронное полотно UNIVERSE"
	></canvas>

	<div class="optical-vignette"></div>

	<!-- ЭТАП 2 (АКТ D): Семантический DOM-контейнер кнопок финальной карточки GitHub и aria-live -->
	<div id="layer5-finale-root"></div>

	<!-- ЭТАП 3: Контейнер паспорта фазы, правой колонки Водопада телеметрии и нижнего дока управления -->
	<div class="hud-overlay" id="hud-overlay-root">
		<!-- ВЕРХНИЙ БАР: Паспорт текущей фазы слева + Полноразмерная колонка телеметрии справа (Layers 2, 3, 4) -->
		<header class="hud-top-bar">
			<section class="hud-panel brand-card" data-ui-panel="true">
				<span class="phase-codename" id="ui-phase-codename">{initialPhase.codeName}</span>
				<h1 class="phase-title" id="ui-phase-title">{initialPhase.titleRu}</h1>
				<p class="phase-subtitle" id="ui-phase-subtitle">{initialPhase.subtitleRu}</p>
				<p class="phase-philosophy" id="ui-phase-philosophy">{initialPhase.philosophyRu}</p>
			</section>

			<div class="inspection-islands-stack" aria-label="Каскад телеметрии Цифрового Водопада">
				<div id="layer2-metrics-root" class="waterfall-island-slot"></div>
				<div id="layer3-topology-root" class="waterfall-island-slot"></div>
				<div id="layer4-terminal-root" class="waterfall-island-slot"></div>
			</div>
		</header>

		<!-- НИЖНИЙ БАР: Навигация по 5 фазам (108 с) и переключение режимов инспекции -->
		<footer class="hud-bottom-bar">
			<nav
				class="hud-panel phase-timeline-dock"
				data-ui-panel="true"
				aria-label="Шкала 5 фаз эволюции Вселенной (108 секунд)"
			>
				<div class="timeline-progress-track">
					<div class="timeline-progress-fill" id="ui-phase-progress"></div>
				</div>
				<div class="phase-buttons-row" id="ui-phase-buttons">
					{
						PHASE_ORDER.map((phaseKey, idx) => (
							<button
								type="button"
								class={`phase-pill ${idx === 0 ? 'active' : ''}`}
								data-phase-id={phaseKey}
								title={UNIVERSE_PHASES[phaseKey].subtitleRu}
							>
								0{idx + 1}.{phaseKey.split('_')[1]}
							</button>
						))
					}
				</div>
			</nav>

			<section
				class="hud-panel controls-dock"
				data-ui-panel="true"
				aria-label="Управление звуком и инженерными оптиками"
			>
				<button type="button" class="btn-cyber" id="btn-toggle-pause" title="Пауза / Продолжить (Клавиша P)">
					⏸ PAUSE
				</button>
				<button type="button" class="btn-cyber active-toggle" id="btn-toggle-autocycle" title="Автоматический 108-секундный цикл">
					🔄 AUTO: ON
				</button>
				<button type="button" class="btn-cyber" id="btn-toggle-audio" title="Включить / Выключить звук (Клавиша M)">
					🔊 AUDIO: WAIT
				</button>
				<button type="button" class="btn-cyber" id="btn-toggle-metrics" title="Телеметрия полиглот-ядра (Клавиша 2)">
					📊 METRICS
				</button>
				<button type="button" class="btn-cyber" id="btn-toggle-topology" title="Топология графа NEXUS (Клавиша 3)">
					🕸 TOPOLOGY
				</button>
				<button type="button" class="btn-cyber" id="btn-toggle-terminal" title="Терминал и IntegrationRegistry (Клавиша 4)">
					⌨ TERMINAL
				</button>
				<button type="button" class="btn-cyber" id="btn-toggle-xray" title="Глобальный инженерный рентген X-RAY (Клавиша 5)">
					🔬 X-RAY
				</button>
			</section>
		</footer>
	</div>
</main>

<script src="../engine/renderer.ts"></script>
</body>
</html>