{
  "name": "universe-polyglot-monorepo",
  "private": true,
  "type": "module",
  "version": "2.5.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix frontend run test",
    "test:python": "python -B -m unittest discover -v",
    "test:rust": "cargo test --manifest-path physics_engine/Cargo.toml --locked",
    "verify:python": "python -B -m backend.main --verify",
    "verify:repo": "node frontend/scripts/verify-repository.mjs",
    "verify:graphics": "node frontend/scripts/verify-graphics-runtime.mjs",
    "verify:all": "npm run verify:repo && npm run verify:python && npm run test:python && npm run test:rust && npm run typecheck && npm test && npm run verify:graphics && npm run build:wasm && npm run verify:wasm && npm run build && npm run verify:pages-artifact",
    "build": "npm --prefix frontend run build",
    "build:wasm": "node frontend/scripts/build-wasm.mjs",
    "verify:wasm": "node frontend/scripts/verify-wasm-runtime.mjs",
    "verify:pages-artifact": "npm --prefix frontend run verify:pages-artifact",
    "preview": "npm --prefix frontend run preview",
    "astro": "npm --prefix frontend run astro"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
